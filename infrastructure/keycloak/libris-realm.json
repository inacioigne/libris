{
  "realm": "libris",
  "enabled": true,
  "registrationAllowed": false,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "client": {
      "libris-api": [
        {
          "name": "libris-reader"
        },
        {
          "name": "libris-cataloger"
        },
        {
          "name": "libris-admin"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "libris-api",
      "enabled": true,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "libris-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/oidc/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/pt##http://localhost:3000/en##http://localhost:3000/pt/opac##http://localhost:3000/en/opac"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile"
      ],
      "protocolMappers": [
        {
          "name": "libris-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "libris-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "libris-api-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "libris-api",
            "claim.name": "resource_access.libris-api.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "libris-user-display-name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "claim.name": "name",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "libris-user-picture",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "picture",
            "claim.name": "picture",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
