@prefix bf: <http://id.loc.gov/ontologies/bibframe/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix libris: <https://example.org/libris/shapes/> .

libris:TitleNodeShape a sh:NodeShape ;
  sh:property [ sh:path bf:mainTitle ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ; sh:minLength 1 ] ;
  sh:property [ sh:path bf:subTitle ; sh:maxCount 1 ; sh:nodeKind sh:Literal ; sh:minLength 1 ] ;
  sh:property [ sh:path bf:partNumber ; sh:maxCount 1 ; sh:nodeKind sh:Literal ; sh:minLength 1 ] ;
  sh:property [ sh:path bf:partName ; sh:maxCount 1 ; sh:nodeKind sh:Literal ; sh:minLength 1 ] ;
  sh:property [ sh:path rdf:type ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (bf:Title bf:VariantTitle bf:ParallelTitle) ] .

libris:WorkTitleShape a sh:NodeShape ; sh:targetClass bf:Work ;
  sh:property [ sh:path bf:title ; sh:minCount 1 ; sh:node libris:TitleNodeShape ;
    sh:qualifiedValueShape [ sh:class bf:Title ] ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ] .

libris:InstanceTitleShape a sh:NodeShape ; sh:targetClass bf:Instance ;
  sh:property [ sh:path bf:title ; sh:minCount 1 ; sh:node libris:TitleNodeShape ;
    sh:qualifiedValueShape [ sh:class bf:Title ] ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ] ;
  sh:property [ sh:path bf:instanceOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class bf:Work ] .
