{
  "name": "@libris/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:integration": "node --conditions=react-server --import tsx --test tests/*.integration.ts",
    "session:prune": "node --import tsx scripts/prune.ts",
    "test:http": "node --conditions=react-server --import tsx --test tests/*.e2e.ts",
    "test:keycloak": "node --conditions=react-server --import tsx --test tests/*.real.ts"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.16",
    "next": "^16.4.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
