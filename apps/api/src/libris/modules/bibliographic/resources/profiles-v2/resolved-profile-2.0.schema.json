  "$id": "urn:libris:schema:resolved-profile:2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "release_id": {
      "title": "Release Id",
      "type": "string"
    },
    "release": {
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$",
      "title": "Release",
      "type": "string"
    },
    "bibliographic_contract": {
      "const": "1.0",
      "default": "1.0",
      "title": "Bibliographic Contract",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "candidate",
        "published",
        "deprecated"
      ],
      "title": "Status",
      "type": "string"
    },
    "category": {
      "enum": [
        "system",
        "institutional",
        "specialization"
      ],
      "title": "Category",
      "type": "string"
    },
    "label": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z]+(?:-[a-zA-Z0-9]+)*$": {
          "minLength": 1,
          "type": "string"
        }
      },
      "title": "Label",
      "type": "object"
    },
    "description": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z]+(?:-[a-zA-Z0-9]+)*$": {
          "minLength": 1,
          "type": "string"
        }
      },
      "title": "Description",
      "type": "object"
    },
    "applies_to": {
      "items": {
        "$ref": "#/$defs/EntityType"
      },
      "minItems": 1,
      "title": "Applies To",
      "type": "array"
    },
    "resource_types": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Resource Types",
      "type": "array"
    },
    "purpose": {
      "default": "cataloging",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "title": "Purpose",
      "type": "string"
    },
    "institution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Institution"
    },
    "priority": {
      "default": 0,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "replacement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replacement"
    },
    "format": {
      "const": "libris.resolved-profile",
      "default": "libris.resolved-profile",
      "title": "Format",
      "type": "string"
    },
    "format_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Format Version",
      "type": "string"
    },
    "lineage": {
      "items": {
        "type": "string"
      },
      "title": "Lineage",
      "type": "array"
    },
    "validation": {
      "items": {
        "$ref": "#/$defs/ShapeReference"
      },
      "title": "Validation",
      "type": "array"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/DeclarativeResource"
      },
      "title": "Resources",
      "type": "array"
    }
  },
  "required": [
    "id",
    "release_id",
    "release",
    "status",
    "category",
    "label",
    "description",
    "applies_to",
    "lineage",
    "validation",
    "resources"
