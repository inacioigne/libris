{
  "$defs": {
    "CatalogPolicy": {
      "additionalProperties": false,
      "properties": {
        "min_count": {
          "default": 0,
          "minimum": 0,
          "title": "Min Count",
          "type": "integer"
        },
        "max_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Count"
        },
        "repeatable": {
          "default": true,
          "title": "Repeatable",
          "type": "boolean"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "allowed_values": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "iri": "#/$defs/IRIDefault",
                "literal": "#/$defs/LiteralDefault"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LiteralDefault"
              },
              {
                "$ref": "#/$defs/IRIDefault"
              }
            ]
          },
          "title": "Allowed Values",
          "type": "array"
        },
        "default": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "iri": "#/$defs/IRIDefault",
                  "literal": "#/$defs/LiteralDefault"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/LiteralDefault"
                },
                {
                  "$ref": "#/$defs/IRIDefault"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "specializable": {
          "default": false,
          "title": "Specializable",
          "type": "boolean"
        }
      },
      "title": "CatalogPolicy",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "present",
            "absent",
            "equals"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "iri": "#/$defs/IRIDefault",
                  "literal": "#/$defs/LiteralDefault"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/LiteralDefault"
                },
                {
                  "$ref": "#/$defs/IRIDefault"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "effect": {
          "enum": [
            "visible",
            "editable",
            "required"
          ],
          "title": "Effect",
          "type": "string"
        }
      },
      "required": [
        "field",
        "operator",
        "effect"
      ],
      "title": "Condition",
      "type": "object"
    },
    "DeclarativeField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
