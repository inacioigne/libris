          "type": "string"
        },
        "property": {
          "title": "Property",
          "type": "string"
        },
        "namespace": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Namespace",
          "type": "string"
        },
        "label": {
          "minProperties": 1,
          "patternProperties": {
            "^[a-zA-Z]+(?:-[a-zA-Z0-9]+)*$": {
              "minLength": 1,
              "type": "string"
            }
          },
          "title": "Label",
          "type": "object"
        },
        "description": {
          "patternProperties": {
            "^[a-zA-Z]+(?:-[a-zA-Z0-9]+)*$": {
              "minLength": 1,
              "type": "string"
            }
          },
          "title": "Description",
          "type": "object"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "authority": "#/$defs/ReferenceValue",
              "entity": "#/$defs/ReferenceValue",
              "iri": "#/$defs/ReferenceValue",
              "relationship": "#/$defs/ReferenceValue",
              "structured": "#/$defs/StructuredValue",
              "text": "#/$defs/TextValue",
              "typed": "#/$defs/TypedValue",
              "vocabulary": "#/$defs/ReferenceValue"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextValue"
            },
            {
              "$ref": "#/$defs/TypedValue"
            },
            {
              "$ref": "#/$defs/ReferenceValue"
            },
            {
              "$ref": "#/$defs/StructuredValue"
            }
          ],
          "title": "Value"
        },
        "policy": {
          "$ref": "#/$defs/CatalogPolicy"
        },
        "presentation": {
          "$ref": "#/$defs/Presentation"
        },
        "derived": {
          "default": false,
          "title": "Derived",
          "type": "boolean"
        },
        "validation": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FieldConstraint"
          },
          "title": "Validation",
          "type": "array"
        },
        "overrides": {
          "default": false,
          "title": "Overrides",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "property",
        "namespace",
        "label",
        "value"
      ],
      "title": "DeclarativeField",
      "type": "object"
    },
    "DeclarativeResource": {
      "additionalProperties": false,
      "properties": {
        "rdf_class": {
          "title": "Rdf Class",
