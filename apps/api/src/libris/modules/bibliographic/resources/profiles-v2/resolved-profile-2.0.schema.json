        "editable": {
          "default": true,
          "title": "Editable",
          "type": "boolean"
        },
        "required_in_form": {
          "default": false,
          "title": "Required In Form",
          "type": "boolean"
        },
        "help": {
          "patternProperties": {
            "^[a-zA-Z]+(?:-[a-zA-Z0-9]+)*$": {
              "minLength": 1,
              "type": "string"
            }
          },
