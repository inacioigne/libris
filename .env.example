# Desenvolvimento local apenas. Copie para .env e escolha uma senha descartável.
POSTGRES_DB=libris
POSTGRES_USER=libris
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
# asyncpg; em Docker, o host é postgres. Fora do Docker, use localhost.
# Se a senha contiver caracteres reservados, codifique-os na URL.
DATABASE_URL=postgresql+asyncpg://libris:change-me-local-only@postgres:5432/libris
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_HEAP=512m
API_PORT=8000
WEB_PORT=3000
APP_ENV=development
# Lista JSON, não valores separados por vírgula. Ajuste ao alterar WEB_PORT.
CORS_ORIGINS=["http://localhost:3000"]
# Somente servidor Next.js; nunca expor senhas como NEXT_PUBLIC_*.
API_INTERNAL_URL=http://api:8000

# Provisória: não define o domínio público definitivo nem implementa resolução HTTP.
RESOURCE_BASE_URI=http://localhost:8000/resources
RDF_MAX_DOCUMENT_BYTES=1048576

# Resource Server OIDC: endpoints protegidos negam acesso quando desabilitado.
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://keycloak.localhost:8081/realms/libris
OIDC_AUDIENCE=libris-api
OIDC_ALGORITHMS=RS256
OIDC_JWKS_CACHE_TTL=300
OIDC_JWKS_REFRESH_INTERVAL=10
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_HTTP_TIMEOUT_SECONDS=5
OIDC_ROLE_SOURCE=client
OIDC_ROLE_CLIENT=libris-api
# Cliente interativo confiável: azp assinado; sem service accounts/token exchange.
OIDC_HUMAN_CLIENT_ID=libris-web
OIDC_ACCESS_TOKEN_CLAIM=typ
OIDC_ACCESS_TOKEN_VALUE=Bearer
# Keycloak no Compose unificado: credenciais administrativas locais obrigatórias.
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# BFF Next.js: local autoriza HTTP somente em localhost/*.localhost.
# Produção: WEB_AUTH_ENV=production, WEB_ORIGIN/issuer/API_INTERNAL_URL HTTPS.
WEB_AUTH_ENV=local
WEB_ORIGIN=http://localhost:3000
WEB_OIDC_ISSUER=http://keycloak.localhost:8081/realms/libris
WEB_OIDC_CLIENT_ID=libris-web
WEB_OIDC_SCOPES=openid profile
# URL pg nativa, não postgresql+asyncpg. Em Docker: host postgres.
# Mesmo banco de DATABASE_URL; credencial de runtime pode ser diferente.
# Instalar tabelas explicitamente com Alembic; ver README.md.
WEB_SESSION_DATABASE_URL=
# JSON {id: chave-base64-32-bytes}; gerar privadamente, nunca versionar.
WEB_SESSION_KEYS=
WEB_SESSION_ACTIVE_KEY=
# Expiração absoluta 8 horas; não é estendida por refresh.
WEB_SESSION_SECONDS=28800

# M04.07: quotas globais por rota, compartilhadas no PostgreSQL libris_web.
# Aplicar explicitamente uv run alembic upgrade head em apps/api antes de login.
WEB_AUTH_RATE_WINDOW_SECONDS=60
WEB_AUTH_LOGIN_LIMIT=120
WEB_AUTH_CALLBACK_LIMIT=240
WEB_AUTH_LOGOUT_LIMIT=240
# Somente produção: 1 afirma proxy TLS confiável como único ingresso, preservando Host.
# Em local manter 0; nunca deduzir esta garantia de X-Forwarded-Proto do cliente.
WEB_HTTPS_TERMINATED=0
